rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile: they may read it and change only their timezone.
    // "connected" and "lastRun" are written by the server only.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['timezone']);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timezone']);

      // Scheduling rules: full access for the owner.
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && (request.method == 'delete' || request.resource.data.name is string);
      }

      // Google refresh tokens: never readable or writable from a browser.
      match /private/{doc} {
        allow read, write: if false;
      }
    }
  }
}
